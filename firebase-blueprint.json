{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with preferences and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat session with AI model",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "model": { "type": "string" },
        "thinkingLevel": { "type": "string" },
        "enableWebSearch": { "type": "boolean" }
      },
      "required": ["id", "title", "createdAt", "updatedAt", "model"]
    },
    "Project": {
      "title": "Project",
      "description": "Knowledge project workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account document"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "User conversation document"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User project document"
    }
  }
}
