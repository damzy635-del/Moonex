# GEMINI_API_KEY: Only used by /api/tts (audio synthesis) and as a fallback
# path — chat/research/code now route through My AI's unified API instead
# of calling Gemini directly. See MYAI_API_URL/MYAI_API_KEY below.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MYAI_API_URL: Base URL of your My AI deployment's unified API (e.g.
# https://your-my-ai-deployment.vercel.app/v1).
MYAI_API_URL="https://your-my-ai-deployment.example.com/v1"

# MYAI_API_KEY: An API key issued by My AI's admin panel (Keys section),
# with at least the "chat" scope. Held server-side only — never sent to
# the browser. See docs/MYAI_INTEGRATION.md for setup and the model-name
# registration this integration depends on (AI_MODEL_ROUTES on the My AI
# deployment).
MYAI_API_KEY="mai_live_..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
